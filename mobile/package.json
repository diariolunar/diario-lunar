{
  "name": "diario-lunar-mobile",
  "version": "1.1.0",
  "private": true,
  "description": "Aplicativo Android do Diario Lunar",
  "scripts": {
    "sync": "cap sync android",
    "assets": "capacitor-assets generate --android --iconBackgroundColor '#f7f4ef' --iconBackgroundColorDark '#f7f4ef' --splashBackgroundColor '#f7f4ef' --splashBackgroundColorDark '#f7f4ef'",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  }
}
